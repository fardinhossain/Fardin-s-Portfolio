# Server-only configuration. Copy to .env locally; never commit the populated file.
# Node 22+ dev server uses process.loadEnvFile when available.
# Alternative: node --env-file=.env server/dev-server.mjs
# On Vercel, set these as server environment variables in project settings.

# Gemini API Key (e.g. from Google AI Studio)
AI_API_KEY=

# Primary model: Gemini 3.5 Flash Lite
AI_MODEL=gemini-3.5-flash-lite

# Secondary fallback model: Gemini 3.6 Flash (used automatically if primary fails)
AI_FALLBACK_MODEL=gemini-3.6-flash

# Google Gemini OpenAI-compatible base endpoint
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional secondary fallback overrides (defaults to AI_API_KEY / AI_BASE_URL if omitted):
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_BASE_URL=

# No client-side VITE_/NEXT_PUBLIC_ variables; no telemetry or chat persistence.
# Rate limiting is best-effort per process (12 requests/minute, 2048 TTL buckets).
# Serverless cold starts/replicas do NOT share limits. Use a shared edge/store
# limiter for production-scale abuse prevention; proxy peers may share a bucket.
