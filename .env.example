# Server-only configuration. Copy to .env locally; never commit the populated file.
# Node 22+ dev server uses process.loadEnvFile when available.
# Alternative: node --env-file=.env server/dev-server.mjs
# On Vercel, set these as server environment variables in project settings.

# Gemini API Key (from Google AI Studio: aistudio.google.com)
# IMPORTANT: When creating your key in Google AI Studio, select "Create API key in new project"
# to ensure it uses the free tier without requiring Google Cloud billing.
AI_API_KEY=

# Optional second API key (fallback if primary key runs out of quota or fails):
# You can also supply two keys comma-separated in AI_API_KEY (e.g. key1, key2)
AI_FALLBACK_API_KEY=

# Primary model (Qwen 3.6 35B via Free.ai OpenAI-compatible endpoint):
AI_MODEL=qwen7b
AI_BASE_URL=https://api.free.ai/v1

# Secondary fallback models (Google Gemini 2.5 Flash & Gemini 2.5 Pro):
AI_FALLBACK_MODEL=gemini-2.5-flash,gemini-2.5-pro
AI_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# No client-side VITE_/NEXT_PUBLIC_ variables; no telemetry or chat persistence.
# Rate limiting is best-effort per process (12 requests/minute, 2048 TTL buckets).
# Serverless cold starts/replicas do NOT share limits. Use a shared edge/store
# limiter for production-scale abuse prevention; proxy peers may share a bucket.
