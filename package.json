{
  "name": "fardin-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/dev-server.mjs",
    "build": "node tools/build-static.mjs",
    "lint": "node tools/check-source.mjs",
